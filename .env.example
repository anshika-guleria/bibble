# Server-side SMTP settings for the profile feedback form.
# For Gmail, use an App Password (not your normal account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-app-password

# Optional sender override; defaults to SMTP_USER.
# SMTP_FROM=Bibble <your-address@gmail.com>

# Feedback recipient. Keep this configured server-side.
FEEDBACK_EMAIL=your-inbox@example.com

SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Browser persistence requires the same public project URL and publishable key.
# Never put a service-role key in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
